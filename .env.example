# ==============================================================================
# Mini-Alexa Environment Variables Template (.env.example)
# Copy this file to .env and insert your real API keys.
# ==============================================================================

# Wake word to activate Mini-Alexa (e.g. jarvis, alexa, computer)
WAKE_WORD=jarvis

# OpenWeatherMap API Key
WEATHER_API_KEY=YOUR_WEATHER_API_KEY_HERE
DEFAULT_CITY=Pune

# LLM Fallback Configuration
# Supported providers: 'nvidia' (default), 'gemini', or 'openai'
LLM_API_KEY=YOUR_LLM_API_KEY_HERE
LLM_PROVIDER=nvidia
LLM_MODEL=nvidia/nemotron-3.5-bolt-e4b
LLM_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions

# Voice & Speech Settings
VOICE_RATE=175
VOICE_VOLUME=1.0
